# ==============================================================================
# n8n Docker Environment Configuration Template
# Copy this file to '.env' and fill in your custom values.
# ==============================================================================

# Timezone setting for containers (crucial for cron/scheduled jobs)
TZ=Asia/Dhaka
GENERIC_TIMEZONE=Asia/Dhaka

# ==============================================================================
# 1. n8n Configuration
# ==============================================================================
# The domain name or IP where n8n will be accessed
DOMAIN_NAME=localhost

# Protocol (http for local testing, https for a public Rocky Linux server)
N8N_PROTOCOL=http

# Full webhook URL. VERY IMPORTANT: Must end with a trailing slash.
# For local dev: http://localhost/
# For Rocky Linux production: https://n8n.yourdomain.com/
WEBHOOK_URL=http://localhost/

# Public URL where users access the n8n editor. Must end with a trailing slash.
N8N_EDITOR_BASE_URL=http://localhost/

# n8n is behind one reverse proxy in this stack: Nginx.
N8N_PROXY_HOPS=1

# Port n8n will run on internally (inside the container)
N8N_PORT=5678

# Security secrets - IMPORTANT: Change these to random values in production!
# You can generate each value using: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change_this_to_a_secure_random_hex_key
N8N_USER_MANAGEMENT_JWT_SECRET=change_this_to_a_secure_random_hex_secret

# Enforce strict permissions on n8n's settings file inside the container
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# ==============================================================================
# 2. PostgreSQL Configuration
# ==============================================================================
POSTGRES_USER=n8n_db_user
POSTGRES_PASSWORD=n8n_secure_db_password_change_me
POSTGRES_DB=n8n_database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==============================================================================
# 3. Nginx / Host Exposed Ports
# ==============================================================================
# Ports exposed on the host machine by the Nginx reverse proxy
HOST_HTTP_PORT=80
HOST_HTTPS_PORT=443
