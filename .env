# ==============================================================================
# n8n Docker Environment Configuration (Active Local Dev Config)
# ==============================================================================

# Timezone setting for containers (crucial for cron/scheduled jobs)
TZ=Asia/Dhaka
GENERIC_TIMEZONE=Asia/Dhaka

# ==============================================================================
# 1. n8n Configuration
# ==============================================================================
# The domain name or IP where n8n will be accessed locally
DOMAIN_NAME=localhost

# Protocol (http for local development)
N8N_PROTOCOL=http

# Full webhook URL. VERY IMPORTANT: Must end with a trailing slash.
WEBHOOK_URL=http://localhost/

# Port n8n will run on internally (inside the container)
N8N_PORT=5678

# Security secrets - Pre-generated for secure local dev
N8N_ENCRYPTION_KEY=c3c8df9e8e244b7cb62ea09c0ebae72f
N8N_USER_MANAGEMENT_JWT_SECRET=fa1dc78b87a41982b614d9b4b0051e704deab21f7d98341b

# Security settings
N8N_BASIC_AUTH_ACTIVE=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# ==============================================================================
# 2. PostgreSQL Configuration
# ==============================================================================
POSTGRES_USER=n8n_db_user
POSTGRES_PASSWORD=n8n_secure_db_password_dev_local
POSTGRES_DB=n8n_database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==============================================================================
# 3. Nginx / Host Exposed Ports
# ==============================================================================
# Ports exposed on the host machine by the Nginx reverse proxy
HOST_HTTP_PORT=80
HOST_HTTPS_PORT=443
